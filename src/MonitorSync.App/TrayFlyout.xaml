<ContextMenu x:Class="MonitorSync.App.TrayFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="280" Placement="MousePoint" Style="{DynamicResource {x:Type ContextMenu}}"
             FontFamily="Segoe UI Variable, Segoe UI" FontSize="14"
             UseLayoutRounding="True" HorizontalContentAlignment="Stretch">
    <ContextMenu.Resources>
        <!-- Embedded controls need no command highlight or checkmark gutter. -->
        <Style x:Key="SliderItem" TargetType="MenuItem">
            <Setter Property="StaysOpenOnClick" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <ContentPresenter ContentSource="Header" Margin="12,4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContextMenu.Resources>
    <MenuItem x:Name="BrightnessItem" Style="{StaticResource SliderItem}" />
    <MenuItem x:Name="VolumeItem" Style="{StaticResource SliderItem}" />
    <Separator />
    <MenuItem x:Name="StartupItem" Header="Start with _Windows" IsCheckable="True"
              StaysOpenOnClick="True" AutomationProperties.Name="Start with Windows" />
    <Separator />
    <MenuItem x:Name="ExitItem" Header="E_xit" AutomationProperties.Name="Exit" />
</ContextMenu>
