<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MonitorSync</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/monitor-sync.ico</ApplicationIcon>
    <!-- WPF owns startup and reads DPI awareness from the manifest; Forms is only the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is used only through an explicit alias for the notification icon and screen coordinates. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MonitorSync.Windows.Tests" />
    <EmbeddedResource Include="../../assets/monitor-sync.ico" LogicalName="MonitorSync.Icon.ico" />
    <EmbeddedResource Include="../../assets/monitor-sync-tray.ico" LogicalName="MonitorSync.Contrast.ico" />
    <Content Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/*" Link="licenses/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../MonitorSync.Windows/MonitorSync.Windows.csproj" />
    <ProjectReference Include="../MonitorSync.Worker/MonitorSync.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyDevelopmentWorker" AfterTargets="Build">
    <ItemGroup><WorkerFiles Include="../MonitorSync.Worker/bin/$(Configuration)/$(TargetFramework)/MonitorSync.Worker.*" /></ItemGroup>
    <Copy SourceFiles="@(WorkerFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
