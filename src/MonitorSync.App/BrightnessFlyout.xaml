<Window x:Class="MonitorSync.App.BrightnessFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brightness" Width="340" Height="96" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" Focusable="False" IsHitTestVisible="False"
        FontFamily="Segoe UI Variable, Segoe UI" UseLayoutRounding="True">
    <Border x:Name="Surface" Margin="16" Padding="20,0" CornerRadius="12" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" />
        </Border.Effect>
        <Grid VerticalAlignment="Center" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Sun" Text="&#xE706;" FontFamily="Segoe Fluent Icons" FontSize="20"
                       VerticalAlignment="Center" AutomationProperties.Name="Brightness" />
            <Grid x:Name="Level" Grid.Column="1" AutomationProperties.LiveSetting="Polite">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center" Height="16">
                    <Border x:Name="Track" Height="4" CornerRadius="2" />
                    <Border x:Name="Fill" Height="4" CornerRadius="2" HorizontalAlignment="Left" />
                    <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left">
                        <Ellipse.RenderTransform><TranslateTransform x:Name="ThumbPosition" /></Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <TextBlock x:Name="Value" Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="Message" Grid.Column="1" FontSize="13" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
